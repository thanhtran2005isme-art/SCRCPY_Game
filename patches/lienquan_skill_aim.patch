+// -------- mouse-aimed skill --------
+
+// Holding the configured key presses the skill button. Mouse deltas move the
+// same virtual finger; releasing the key sends ACTION_UP to cast the skill.
+void InputConvertGame::processSkillAim(const KeyMap::KeyMapNode &node, const QKeyEvent *from)
+{
+    if (!from || from->isAutoRepeat()) {
+        return;
+    }
+
+    const int key = from->key();
+    if (QEvent::KeyPress == from->type()) {
+        if (m_ctrlSkillAim.key != Qt::Key_unknown) {
+            stopSkillAim();
+        }
+
+        // Avoid two virtual fingers competing for the same game gesture.
+        stopMouseMoveTimer();
+        mouseMoveStopTouch();
+
+        const int id = attachTouchID(key);
+        if (id < 0) {
+            qWarning() << "No free touch ID for skill aim key:" << key;
+            return;
+        }
+
+        m_ctrlSkillAim.key = key;
+        m_ctrlSkillAim.currentPos = node.data.click.keyNode.pos;
+        m_ctrlSkillAim.lastMousePos = m_ctrlMouseMove.lastPos;
+        m_ctrlSkillAim.hasLastMousePos = !m_ctrlMouseMove.lastPos.isNull();
+        m_ctrlSkillAim.speedX = node.data.click.aimSpeedX > 0.001f ? node.data.click.aimSpeedX : 1.5f;
+        m_ctrlSkillAim.speedY = node.data.click.aimSpeedY > 0.001f ? node.data.click.aimSpeedY : 1.5f;
+
+        // In configs without mouseMoveMap, capture/hide the mouse only while aiming.
+        if (!m_keyMap.isValidMouseMoveMap()) {
+#ifdef QT_NO_DEBUG
+            emit grabCursor(true);
+#endif
+            hideMouseCursor(true);
+            m_ctrlSkillAim.cursorCaptured = true;
+            m_ctrlSkillAim.hasLastMousePos = false;
+        }
+
+        sendTouchDownEvent(id, m_ctrlSkillAim.currentPos);
+        m_ctrlMouseMove.lastPos = QPointF();
+        m_ctrlMouseMove.lastConverPos = QPointF();
+        return;
+    }
+
+    if (QEvent::KeyRelease == from->type() && m_ctrlSkillAim.key == key) {
+        stopSkillAim();
+    }
+}
+
+void InputConvertGame::stopSkillAim()
+{
+    if (m_ctrlSkillAim.key == Qt::Key_unknown) {
+        return;
+    }
+
+    const int key = m_ctrlSkillAim.key;
+    const int id = getTouchID(key);
+    if (id >= 0) {
+        sendTouchUpEvent(id, m_ctrlSkillAim.currentPos);
+        detachTouchID(key);
+    }
+
+    if (m_ctrlSkillAim.cursorCaptured) {
+#ifdef QT_NO_DEBUG
+        emit grabCursor(false);
+#endif
+        hideMouseCursor(false);
+        m_ctrlSkillAim.cursorCaptured = false;
+    }
+
+    m_ctrlSkillAim.key = Qt::Key_unknown;
+    m_ctrlSkillAim.hasLastMousePos = false;
+    m_ctrlSkillAim.lastMousePos = QPointF();
+    m_ctrlMouseMove.lastPos = QPointF();
+    m_ctrlMouseMove.lastConverPos = QPointF();
+}
