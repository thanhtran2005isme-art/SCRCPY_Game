+
+bool InputConvertGame::processSkillAimMouseMove(const QMouseEvent *from)
+{
+    if (!from || m_ctrlSkillAim.key == Qt::Key_unknown) {
+        return false;
+    }
+
+    // Do not inject an extra mouse-touch while the skill finger is active.
+    if (from->type() != QEvent::MouseMove) {
+        return true;
+    }
+
+    // Reset the delta baseline after cursor recentering to avoid an aiming jump.
+    if (checkCursorPos(from)) {
+        m_ctrlSkillAim.hasLastMousePos = false;
+        m_ctrlMouseMove.lastPos = QPointF();
+        return true;
+    }
+
+    QPointF mousePos;
+#if (QT_VERSION < QT_VERSION_CHECK(6, 0, 0))
+    mousePos = from->localPos();
+#else
+    mousePos = from->position();
+#endif
+
+    if (!m_ctrlSkillAim.hasLastMousePos) {
+        m_ctrlSkillAim.lastMousePos = mousePos;
+        m_ctrlSkillAim.hasLastMousePos = true;
+        return true;
+    }
+
+    const QPointF delta = mousePos - m_ctrlSkillAim.lastMousePos;
+    m_ctrlSkillAim.lastMousePos = mousePos;
+    if (m_showSize.width() <= 0 || m_showSize.height() <= 0 || delta.isNull()) {
+        return true;
+    }
+
+    QPointF nextPos = m_ctrlSkillAim.currentPos;
+    nextPos.rx() += delta.x() / (m_showSize.width() * m_ctrlSkillAim.speedX);
+    nextPos.ry() += delta.y() / (m_showSize.height() * m_ctrlSkillAim.speedY);
+    nextPos.setX(qBound<qreal>(0.01, nextPos.x(), 0.99));
+    nextPos.setY(qBound<qreal>(0.01, nextPos.y(), 0.99));
+
+    if (nextPos != m_ctrlSkillAim.currentPos) {
+        m_ctrlSkillAim.currentPos = nextPos;
+        const int id = getTouchID(m_ctrlSkillAim.key);
+        if (id >= 0) {
+            sendTouchMoveEvent(id, m_ctrlSkillAim.currentPos);
+        }
+    }
+    return true;
+}
