+// Poll physical WASD state independently of Qt key-release delivery. This is
+// a failsafe against a stuck virtual joystick when focus changes.
+void InputConvertGame::onSteerWheelKeyStateTimer()
+{
+#ifdef Q_OS_WIN32
+    if (m_ctrlSteerWheel.touchKey == Qt::Key_unknown) {
+        return;
+    }
+
+    const KeyMap::KeyMapNode &node = m_keyMap.getKeyMapNodeKey(m_ctrlSteerWheel.touchKey);
+    if (node.type != KeyMap::KMT_STEER_WHEEL) {
+        return;
+    }
+
+    auto isDown = [](int key) {
+        if ((key >= Qt::Key_A && key <= Qt::Key_Z) ||
+            (key >= Qt::Key_0 && key <= Qt::Key_9)) {
+            return (GetAsyncKeyState(key) & 0x8000) != 0;
+        }
+        return true;
+    };
+
+    const bool upDown = isDown(node.data.steerWheel.up.key);
+    const bool rightDown = isDown(node.data.steerWheel.right.key);
+    const bool downDown = isDown(node.data.steerWheel.down.key);
+    const bool leftDown = isDown(node.data.steerWheel.left.key);
+
+    // Emergency release: if none of the mapped movement keys is physically
+    // held, issue ACTION_UP directly instead of trusting cached key flags.
+    if (!upDown && !rightDown && !downDown && !leftDown) {
+        if (m_ctrlSteerWheel.delayData.timer->isActive()) {
+            m_ctrlSteerWheel.delayData.timer->stop();
+        }
+        m_ctrlSteerWheel.delayData.queueTimer.clear();
+        m_ctrlSteerWheel.delayData.queuePos.clear();
+
+        const int touchId = getTouchID(m_ctrlSteerWheel.touchKey);
+        if (touchId >= 0) {
+            sendTouchUpEvent(touchId, m_ctrlSteerWheel.delayData.currentPos);
+            detachTouchID(m_ctrlSteerWheel.touchKey);
+        }
+        m_ctrlSteerWheel.touchKey = Qt::Key_unknown;
+        m_ctrlSteerWheel.pressedUp = false;
+        m_ctrlSteerWheel.pressedRight = false;
+        m_ctrlSteerWheel.pressedDown = false;
+        m_ctrlSteerWheel.pressedLeft = false;
+        m_ctrlSteerWheel.delayData.pressedNum = 0;
+        m_ctrlSteerWheel.delayData.currentPos = node.data.steerWheel.centerPos;
+        return;
+    }
+
+    auto releaseIfUp = [this, &node, &isDown](int key, bool pressed) {
+        if (pressed && !isDown(key)) {
+            QKeyEvent releaseEvent(QEvent::KeyRelease, key, Qt::NoModifier);
+            processSteerWheel(node, &releaseEvent);
+        }
+    };
+    releaseIfUp(node.data.steerWheel.up.key, m_ctrlSteerWheel.pressedUp);
+    releaseIfUp(node.data.steerWheel.right.key, m_ctrlSteerWheel.pressedRight);
+    releaseIfUp(node.data.steerWheel.down.key, m_ctrlSteerWheel.pressedDown);
+    releaseIfUp(node.data.steerWheel.left.key, m_ctrlSteerWheel.pressedLeft);
+#endif
+}
